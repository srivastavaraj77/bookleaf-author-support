# BookLeaf Backend Environment Configuration
PROJECT_NAME="BookLeaf Publishing Author Support & Communication Portal"
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (defaults to local SQLite if unset, or PostgreSQL)
DATABASE_URL=sqlite:///./bookleaf.db
# DATABASE_URL=postgresql://bookleaf_user:bookleaf_secure_password_2025@localhost:5432/bookleaf_db

# Generative AI Provider: "auto" | "gemini" | "openai" | "mock"
AI_PROVIDER=auto

# Optional API Keys (Leave blank to use zero-config calibrated dev-mock provider)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model specifications
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# CORS allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "*"]
